    "## 1. Ownership": [
     [
      "LLM credentials",
      "OMP",
      "`ctx.modelRegistry.resolver(model, sessionId)` (OAuth refresh, key rotation, auth retry)"
     ],
     [
      "LLM model resolution",
      "OMP",
      "`ctx.models.resolve(spec)` for `@slow`, `@smol`, roles, `provider/id`, bare ids; `ctx.models.current()` for `current`"
     ],
     [
      "LLM inference",
      "OMP",
      "`@oh-my-pi/pi-ai` `completeSimple(model, context, {apiKey, reasoning, maxTokens, signal})`"
     ],
     [
      "Reasoning levels",
      "OMP",
      "`reasoning: Effort` / `disableReasoning`; jev-opt only forwards the configured value"
     ],
     [
      "Reflective optimization",
      "GEPA",
      "`gepa.optimize(..., reflection_lm=OMPReflectionLM)` and GEPA's `InstructionProposalSignature`"
     ],
     [
      "Pareto candidate search",
      "GEPA",
      "`candidate_selection_strategy=\"pareto\"`, `frontier_type=\"hybrid\"` with `objective_scores`"
     ],
     [
      "Candidate scheduling / sampling",
      "GEPA",
      "`EpochShuffledBatchSampler`, `module_selector=\"round_robin\"`, `use_merge`"
     ],
     [
      "Stopping",
      "GEPA",
      "`max_metric_calls`, `max_reflection_cost`, `run_dir` file stopper (`gepa.stop`)"
     ],
     [
      "Generic persistence / resume",
      "GEPA",
      "`run_dir/gepa_state.bin`, `run_log.json`, `candidates.json`"
     ],
     [
      "Experiment callbacks",
      "GEPA",
      "`callbacks=[...]` → forwarded to OMP as progress notifications"
     ],
     [
      "Jev program representation",
      "jev-opt",
      "Pydantic IR (`jev_opt.ir`), YAML/JSON"
     ],
     [
      "Jev transformations",
      "jev-opt",
      "`jev_opt.transforms` (deterministic) + structural reflection prompt"
     ],
     [
      "Jev API execution",
      "jev-opt",
      "`jev_opt.jev` (Decisions API client, retries, pacing, usage, cache)"
     ],
     [
      "Threshold / aggregation fitting",
      "jev-opt",
      "`jev_opt.fit` (numerical; scipy/numpy, no LLM)"
     ],
     [
      "Task metrics",
      "jev-opt (sklearn)",
      "`jev_opt.metrics` wraps scikit-learn; ECE is the only hand-written metric"
     ],
     [
      "Task evaluation",
      "jev-opt / GEPA adapter",
      "`jev_opt.adapter.JevAdapter` implements GEPA's `GEPAAdapter` protocol"
     ],
     [
      "Progressive validation",
      "jev-opt via GEPA protocol",
      "`ProgressivePolicy` implements GEPA's `EvaluationPolicy` protocol (0.1.4 ships only full eval)"
     ],
     [
      "Test-set isolation",
      "jev-opt",
      "worker never loads the test split except in `evaluate_final`; consumption ledger"
     ],
     [
      "Experiment reporting",
      "jev-opt",
      "`runs/<id>/report.md`, representatives, `environment.json`"
     ],
     [
      "UI / commands / worker lifecycle",
      "jev-opt (OMP extension)",
      "`/jev-optimize`, `/jev-status`, … registered with `pi.registerCommand`"
     ]
    ],
    "structural operators": [
